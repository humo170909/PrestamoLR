# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local.
# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo desarrollo local, SIN Supabase: habilita los usuarios de demostración de lib/auth.ts.
# Se ignora en producción y cuando Supabase está configurado.
NEXT_PUBLIC_ENABLE_DEMO_AUTH=false

# Opcional: dato de contacto de soporte que muestra el botón «Contáctanos» del login (texto plano, p. ej. WhatsApp o correo del administrador).
NEXT_PUBLIC_SUPPORT_CONTACT=

# OBLIGATORIA, solo servidor (nunca NEXT_PUBLIC_): alta de usuarios, Telegram, avisos de pago y cron.
# Panel de Supabase > Project Settings > API > service_role. Salta RLS: no la compartas ni la subas.
SUPABASE_SERVICE_ROLE_KEY=

# ── Recordatorios por Telegram (solo servidor; nunca NEXT_PUBLIC_) ──
# 1) En Telegram habla con @BotFather > /newbot y copia el token.
# 2) Escribe a tu bot (o añádelo a tu grupo) y obtén el chat id (grupos: número negativo).
# El token y los chats también se pueden configurar desde el panel (Configuración > Telegram);
# el token queda cifrado en la base de datos con TELEGRAM_ENCRYPTION_KEY. Estas dos variables son solo un respaldo.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # uno o varios separados por coma
# Secreto con el que Vercel Cron autentica la llamada (genera uno largo y aleatorio).
CRON_SECRET=
# Clave para cifrar el token guardado desde el panel: 64 caracteres hexadecimales. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guárdala bien: si la pierdes o cambias, hay que volver a escribir el token en el panel.
TELEGRAM_ENCRYPTION_KEY=
